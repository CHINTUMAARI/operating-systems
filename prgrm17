#include <stdio.h>

int main() {
    int n,m,i,j,k;
    int alloc[10][10], max[10][10], need[10][10], avail[10];

    printf("Enter processes and resources: ");
    scanf("%d%d",&n,&m);

    printf("Enter Allocation Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&alloc[i][j]);

    printf("Enter Max Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&max[i][j]);

    printf("Enter Available Resources:\n");
    for(j=0;j<m;j++)
        scanf("%d",&avail[j]);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            need[i][j] = max[i][j] - alloc[i][j];

    int finish[10]={0}, safe[10], count=0;

    while(count<n) {
        for(i=0;i<n;i++) {
            if(!finish[i]) {
                int flag=1;
                for(j=0;j<m;j++)
                    if(need[i][j] > avail[j])
                        flag=0;
                if(flag) {
                    for(j=0;j<m;j++)
                        avail[j]+=alloc[i][j];
                    safe[count++]=i;
                    finish[i]=1;
                }
            }
        }
    }

    printf("Safe Sequence: ");
    for(i=0;i<n;i++)
        printf("P%d ",safe[i]);
    return 0;
}
