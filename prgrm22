#include <stdio.h>

int main() {
    int block[10], process[10], m, n, i, j, best;

    printf("Enter blocks: ");
    scanf("%d",&m);
    for(i=0;i<m;i++) scanf("%d",&block[i]);

    printf("Enter processes: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&process[i]);

    for(i=0;i<n;i++) {
        best = -1;
        for(j=0;j<m;j++)
            if(block[j] >= process[i])
                if(best == -1 || block[j] < block[best])
                    best = j;

        if(best != -1) {
            printf("Process %d allocated Block %d\n",i+1,best+1);
            block[best] -= process[i];
        } else {
            printf("Process %d Not Allocated\n",i+1);
        }
    }
}
