#include <stdio.h>
#include <stdlib.h>

int findOptimal(int pages[], int n, int frame[], int f, int index) {
    int res = -1, farthest = index;
    for (int i = 0; i < f; i++) {
        int j;
        for (j = index; j < n; j++) {
            if (frame[i] == pages[j]) {
                if (j > farthest) {
                    farthest = j;
                    res = i;
                }
                break;
            }
        }
        if (j == n) return i;
    }
    return (res == -1) ? 0 : res;
}

void optimalPage(int pages[], int n, int f) {
    int frame[f];
    for (int i = 0; i < f; i++) frame[i] = -1;
    int hit = 0;
    for (int i = 0; i < n; i++) {
        int j;
        for (j = 0; j < f; j++) {
            if (frame[j] == pages[i]) {
                hit++;
                break;
            }
        }
        if (j == f) {
            int index = findOptimal(pages, n, frame, f, i + 1);
            frame[index] = pages[i];
        }
    }
    printf("Hit Ratio: %f\n", (float)hit / n);
}

