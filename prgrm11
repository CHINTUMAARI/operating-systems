#include <stdio.h>
#include <pthread.h>

void* threadFunc(void *arg) {
    printf("Thread Running...\n");
    return NULL;
}

int main() {
    pthread_t t1, t2;

    pthread_create(&t1, NULL, threadFunc, NULL);
    pthread_create(&t2, NULL, threadFunc, NULL);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    printf("Main Thread Ended\n");
    return 0;
}
