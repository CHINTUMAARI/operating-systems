#include <stdio.h>

int main() {
    int block[10], process[10], m, n, i, j;

    printf("Enter blocks: ");
    scanf("%d",&m);
    for(i=0;i<m;i++) scanf("%d",&block[i]);

    printf("Enter processes: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&process[i]);

    for(i=0;i<n;i++) {
        for(j=0;j<m;j++) {
            if(block[j] >= process[i]) {
                printf("Process %d allocated Block %d\n",i+1,j+1);
                block[j] -= process[i];
                break;
            }
        }
        if(j == m)
            printf("Process %d Not Allocated\n",i+1);
    }
}
