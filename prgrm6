#include <stdio.h>

int main() {
    int n, i, time = 0, highest, remaining;
    int bt[10], rt[10], pr[10], complete = 0;
    int wt[10] = {0}, tat[10];

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++) {
        printf("Burst Time P%d: ", i+1);
        scanf("%d",&bt[i]);
        printf("Priority P%d: ", i+1);
        scanf("%d",&pr[i]);
        rt[i] = bt[i];
    }

    remaining = n;
    while(remaining > 0) {
        highest = -1;
        for(i=0;i<n;i++) {
            if(rt[i] > 0 && (highest == -1 || pr[i] < pr[highest])) {
                highest = i;
            }
        }

        rt[highest]--;
        time++;

        if(rt[highest] == 0) {
            remaining--;
            complete = time;
            tat[highest] = complete;
            wt[highest] = tat[highest] - bt[highest];
        }
    }

    printf("\nP\tBT\tPR\tWT\tTAT\n");
    for(i=0;i<n;i++)
        printf("P%d\t%d\t%d\t%d\t%d\n",i+1,bt[i],pr[i],wt[i],tat[i]);

    return 0;
