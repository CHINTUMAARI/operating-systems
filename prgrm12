#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t fork[5];

void* philosopher(void *num) {
    int id = (int)num;

    printf("Philosopher %d is thinking\n", id);
    sem_wait(&fork[id]);
    sem_wait(&fork[(id+1)%5]);

    printf("Philosopher %d is eating\n", id);

    sem_post(&fork[id]);
    sem_post(&fork[(id+1)%5]);
}

int main() {
    pthread_t ph[5];
    int i, n[5];

    for(i=0;i<5;i++)
        sem_init(&fork[i],0,1);

    for(i=0;i<5;i++) {
        n[i]=i;
        pthread_create(&ph[i],NULL,philosopher,&n[i]);
    }

    for(i=0;i<5;i++)
        pthread_join(ph[i],NULL);

    return 0;
}
